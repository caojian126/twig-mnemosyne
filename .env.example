# ─── Database ───
DB_PASSWORD=your_secure_db_password_here

# ─── Encryption（32 字节 base64；openssl rand -base64 32）───
ENCRYPTION_KEY=your_32_byte_base64_key_here
# CONFIRM_SECRET / BROKER_INTERNAL_TOKEN 在 NODE_ENV=production 下不允许保留 insecure-dev 默认值，
# 否则启动即 fail-fast（runtime/src/config.ts）。

# ─── API Keys (LLM Provider) ───
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
DEEPSEEK_API_KEY=sk-...
GEMINI_API_KEY=...
MOONSHOT_API_KEY=sk-...
# 中转/聚合渠道（MODEL_REGISTRY 里的中转模型依赖；不用对应模型可留空）
COMMANDCODE_API_KEY=...
OPENCODE_API_KEY=...
SILICONFLOW_API_KEY=...

# ─── TTS Provider（§21；云端优先链 elevenlabs→siliconflow→openai，OPENAI_API_KEY 复用上方）───
ELEVENLABS_API_KEY=sk_...            # 质量天花板；Free tier 10k chars/月
ELEVENLABS_VOICE_ID=                 # ElevenLabs 声音 ID（如 Lily）；留空则不合成、静默降级为文字
TTS_SILICONFLOW_VOICE=FunAudioLLM/CosyVoice2-0.5B:alex   # 渡鸦人格默认男声 alex
TTS_OPENAI_VOICE=alloy

# ─── LiteLLM ───
LITELLM_MASTER_KEY=sk-litellm-...

# ─── Local Model Sidecar（§20）───
# 形态 A（Tailscale 分离部署，推荐）：OLLAMA_API_BASE=http://100.x.x.x:11434
# 形态 B（同机 profile）：OLLAMA_API_BASE=http://ollama:11434
OLLAMA_API_BASE=http://ollama:11434

# ─── Twig Memory ───
KIMI_API_KEY=sk-...
MUNINN_AUTH_TOKEN=your_twig_auth_token
MUNINN_TZ=Asia/Shanghai

# ─── 反刍排程（Runtime 侧每日 cron；认识层唯一写入者）───
# 设为 0 关闭；REFLECT_CRON 按服务器时区解释（容器为 UTC）
REFLECT_ENABLED=1
REFLECT_CRON=30 18 * * *
REFLECT_ACTIVE_HOURS=24
REFLECT_TIMEOUT_MS=900000

# ─── Grafana（仅在 monitoring profile 启用时需要）───
GRAFANA_PASSWORD=your_grafana_password

# ─── 管理与观测（runtime）───
# admin endpoints（/v1/admin/*）独立凭证；恒时比较。留空 = admin 面关闭
ADMIN_TOKEN=
# /metrics 抓取凭证（Bearer）；留空 = 公开（内网 Prometheus 直采场景）。
# 公网面已由 Caddy 对 /metrics 直接 403——此处 token 是内网抓取器可选的第二道门
METRICS_TOKEN=

# ─── 反向代理（Zeabur / Caddy 后 req.ip 需要）───
# 可信反代跳数；直连暴露（无反代）部署设 0，否则限流键会被伪造 XFF 污染
TRUST_PROXY_HOPS=1

# ─── MCP Gateway（mcp-gateway 服务自身的凭证与调优；与 runtime 共享 token）───
BROKER_INTERNAL_TOKEN=your_broker_shared_secret
# 动态注册预注册清单（JSON 数组 [{name,url,headers?,skill_document?}]；Bearer 只走 env 不入 git）
MCP_BOOT_REGISTRATIONS=
# builtin 学术工具凭证 / 礼貌头（缺省走无 key 兜底池）
SEMANTIC_SCHOLAR_API_KEY=...
OPENALEX_EMAIL=you@example.com
DEFAULT_TIMEZONE=Asia/Shanghai

# ─── 确认协议（§4.6 HMAC 票据密钥）───
CONFIRM_SECRET=your_hmac_secret_for_confirmation_tickets

# ─── MCP Gateway 连接（runtime → gateway；§5 工具执行回路）───
# 本地 dev 默认 http://127.0.0.1:3000；compose 内为 http://mcp-gateway:3000；
# Zeabur 用私有地址（形如 http://mcp-gateway.zeabur.internal:3000）。
# ⚠️ 不配 = 工具全废且静默（模型收不到结果就开始瞎编）；/health 的 mcp 字段可验。
MCP_GATEWAY_URL=

# ─── Telegram 适配层（§1 传输层；留空 = 轮询关闭）───
TELEGRAM_BOT_TOKEN=

# ─── Bootstrap（首个用户仅能用一次；用后从环境中移除）───
BOOTSTRAP_TOKEN=one_time_bootstrap_token

# ─── Webhook 校验链（§2.5.1）───
# LAN 场景显式开启才允许 http（生产保持为空/0）
ALLOW_INSECURE_WEBHOOK=0
# 可选白名单，逗号分隔；配置后仅允许列内主机
WEBHOOK_HOST_ALLOWLIST=

# ─── Runtime 运行参数 ───
PRIVACY_LOCAL_THRESHOLD=70
CRISIS_SILENCE_HOURS=24
MAX_MESSAGE_TOKENS=4096
# 单腿模型调用超时（默认 90000；推理型模型思考偏长可调大）
MODEL_TIMEOUT_MS=90000
# 默认 fallback 链（逗号分隔；默认 kimi-k2.6,gpt-4o,claude-sonnet,gemini-pro）
DEFAULT_MODEL_CHAIN=

# ─── 备份（§13.6）───
# VPS 版 backup.sh 的 restic 异地加密（密码入密码管理器，不进 git）
BACKUP_RESTIC_PASSWORD=your_restic_password
B2_ACCOUNT_ID=...
B2_ACCOUNT_KEY=...
# 本地备份失败通知（可选；backup-local.mjs 读 scripts/backup.local.env 或此处）
NOTIFY_TG_BOT_TOKEN=
NOTIFY_TG_CHAT_ID=
